# ATLAS — Configuración de entorno
# Copiar este archivo a .env y completar los valores reales antes de "docker compose up --build"

# ===== App =====
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:H3aIq9nDkq7Qg6whcVPlOSLBXq3i1/kUe/QkA0US7o4=

# Puerto público del gateway NGINX
HTTP_PORT=8080

# ===== Métodos de autenticación =====
# AUTH_LOCAL_ENABLED=true habilita login con usuario/contraseña almacenados en BD
#   (usar el comando: php artisan atlas:user <username> --password=... --rol=admin)
# AUTH_LDAP_ENABLED=true habilita login contra LDAP/AD
# Si ambos están en true, primero se intenta local y, si falla, se cae a LDAP
AUTH_LOCAL_ENABLED=true
AUTH_LDAP_ENABLED=false

# ===== Base de Datos (MySQL 8) =====
DB_NAME=atlas_db
DB_USER=atlas_user
DB_PASSWORD=test
DB_ROOT_PASSWORD=atlas_root_pass_2024

# ===== LDAP / Active Directory =====
# El organismo proveerá los valores reales
LDAP_HOST=ldap.organismo.gob.ar
LDAP_PORT=389
LDAP_BASE_DN=dc=organismo,dc=gob,dc=ar
LDAP_USERNAME=cn=service_account,dc=organismo,dc=gob,dc=ar
LDAP_PASSWORD=service_account_password
LDAP_USE_SSL=false
LDAP_USE_TLS=false
# Atributo usado para identificar al usuario (sAMAccountName en AD, uid en OpenLDAP)
LDAP_USER_ATTRIBUTE=sAMAccountName

# ===== Primer Administrador =====
# Username del AD que se cargará con rol "admin" en el primer arranque
FIRST_ADMIN_USERNAME=admin

# ===== Acceso remoto vía ngrok (perfil "tunnel", opcional) =====
# Generar token gratuito en https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=2KPRTM2QiOWkOcvAGZae72SedAC_79Um5GtBRyXxDaLkkwWvD
# Dominio reservado opcional (cuentas free pueden reservar uno: ej. atlas-demo.ngrok-free.app).
# Si se deja vacío, ngrok asigna un subdominio aleatorio en cada arranque.
NGROK_DOMAIN=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33061
DB_DATABASE=atlas_db
DB_USERNAME=root